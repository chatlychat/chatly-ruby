# frozen_string_literal: true

require_relative "lib/chatly/version"

Gem::Specification.new do |spec|
  spec.name = "chatly"
  spec.version = Chatly::VERSION
  spec.authors = ["Chatly"]
  spec.email = ["support@chatlychat.com"]

  spec.summary = "Official Ruby SDK for the Chatly live chat and customer messaging platform."
  spec.description = <<~DESC
    Backend Ruby client for the Chatly REST API: contacts, conversations,
    messages, tickets, macros, knowledge base, search, CDP events, webhook
    deliveries, reports, channels, billing and workspace configuration.
    Includes typed errors, automatic retries with idempotency, auto-paginating
    enumerators, webhook signature verification and widget identity hashing.
    Zero runtime dependencies -- standard library only.
  DESC

  spec.homepage = "https://chatlychat.com"
  # The license is MIT, and the text of it is the LICENSE file beside this
  # one -- copied verbatim from the Node SDK so every binding ships the same
  # terms rather than a retyped approximation of them.
  spec.license = "MIT"
  spec.required_ruby_version = ">= 3.0.0"

  spec.metadata = {
    "homepage_uri" => spec.homepage,
    "documentation_uri" => "https://chatlychat.com/docs",
    "source_code_uri" => "https://github.com/chatlychat/chatly",
    "bug_tracker_uri" => "https://github.com/chatlychat/chatly/issues",
    "changelog_uri" => "https://github.com/chatlychat/chatly/blob/main/packages/sdk-ruby/CHANGELOG.md",
    # Published from a monorepo, so point the pusher at the right subtree
    # rather than letting them guess from `source_code_uri`.
    "rubygems_mfa_required" => "true"
  }

  # Listed explicitly, not globbed from `git ls-files`: this gem lives in a
  # monorepo, so a glob over the working tree would happily package a
  # sibling package's build output, and `git ls-files` silently omits a file
  # that has not been staged yet.
  spec.files = [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "chatly.gemspec",
    # Parity evidence, regenerated by `test/surface_lock_test.rb` on every
    # run. Shipped so a published gem can be checked against the manifest
    # without the monorepo.
    "surface.lock.json",
    "lib/chatly.rb",
    "lib/chatly/client.rb",
    "lib/chatly/errors.rb",
    "lib/chatly/identity.rb",
    "lib/chatly/pagination.rb",
    "lib/chatly/transport.rb",
    "lib/chatly/version.rb",
    "lib/chatly/webhooks.rb",
    "lib/chatly/resources/base.rb",
    "lib/chatly/resources/billing.rb",
    "lib/chatly/resources/channels.rb",
    "lib/chatly/resources/contacts.rb",
    "lib/chatly/resources/conversations.rb",
    "lib/chatly/resources/events.rb",
    "lib/chatly/resources/kb.rb",
    "lib/chatly/resources/macros.rb",
    "lib/chatly/resources/reports.rb",
    "lib/chatly/resources/search.rb",
    "lib/chatly/resources/tickets.rb",
    "lib/chatly/resources/webhooks.rb",
    "lib/chatly/resources/workspace.rb"
  ]
  spec.require_paths = ["lib"]

  # No runtime dependencies, and none is coming. `net/http`, `json`,
  # `openssl`, `securerandom`, `time` and `uri` are all standard library. A
  # customer should not inherit our dependency tree to send a message.
  #
  # No development dependencies either: the suite is stdlib `minitest` run
  # directly (`ruby -Ilib -Itest test/all.rb`), so there is nothing to
  # `bundle install` before working on this gem.
end
